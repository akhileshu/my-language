LET IDENTIFIER("name") EQUAL STRING("world")
LET IDENTIFIER("age") EQUAL NUMBER(23)
LET IDENTIFIER("active") EQUAL TRUE
LET IDENTIFIER("nothing") EQUAL NULL

IDENTIFIER("print") LEFT_PAREN IDENTIFIER("name") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("age") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("active") RIGHT_PAREN

LET IDENTIFIER("a") EQUAL NUMBER(10)
LET IDENTIFIER("b") EQUAL NUMBER(3)

IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") PLUS IDENTIFIER("b") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") MINUS IDENTIFIER("b") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") STAR IDENTIFIER("b") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") SLASH IDENTIFIER("b") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") PERCENT IDENTIFIER("b") RIGHT_PAREN

IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") GREATER IDENTIFIER("b") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") EQUAL_EQUAL IDENTIFIER("b") RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("a") BANG_EQUAL IDENTIFIER("b") RIGHT_PAREN

IDENTIFIER("print") LEFT_PAREN TRUE AND FALSE RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN TRUE OR FALSE RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN BANG TRUE RIGHT_PAREN

LET IDENTIFIER("x") EQUAL NUMBER(10)
IDENTIFIER("x") EQUAL IDENTIFIER("x") PLUS NUMBER(5)
IDENTIFIER("x") EQUAL IDENTIFIER("x") STAR NUMBER(2)
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("x") RIGHT_PAREN

IF LEFT_PAREN IDENTIFIER("x") GREATER NUMBER(20) RIGHT_PAREN LEFT_BRACE
IDENTIFIER("print") LEFT_PAREN STRING("x is large") RIGHT_PAREN
RIGHT_BRACE ELSE LEFT_BRACE
IDENTIFIER("print") LEFT_PAREN STRING("x is small") RIGHT_PAREN
RIGHT_BRACE

LET IDENTIFIER("i") EQUAL NUMBER(0)

WHILE LEFT_PAREN IDENTIFIER("i") LESS NUMBER(5) RIGHT_PAREN LEFT_BRACE
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("i") RIGHT_PAREN
IDENTIFIER("i") EQUAL IDENTIFIER("i") PLUS NUMBER(1)
RIGHT_BRACE

FN IDENTIFIER("add") LEFT_PAREN IDENTIFIER("a") COMMA IDENTIFIER("b") RIGHT_PAREN LEFT_BRACE
RETURN IDENTIFIER("a") PLUS IDENTIFIER("b")
RIGHT_BRACE

LET IDENTIFIER("result") EQUAL IDENTIFIER("add") LEFT_PAREN NUMBER(10) COMMA NUMBER(20) RIGHT_PAREN
IDENTIFIER("print") LEFT_PAREN IDENTIFIER("result") RIGHT_PAREN

FN IDENTIFIER("factorial") LEFT_PAREN IDENTIFIER("n") RIGHT_PAREN LEFT_BRACE
IF LEFT_PAREN IDENTIFIER("n") LESS_EQUAL NUMBER(1) RIGHT_PAREN LEFT_BRACE
RETURN NUMBER(1)
RIGHT_BRACE
RETURN IDENTIFIER("n") STAR IDENTIFIER("factorial") LEFT_PAREN IDENTIFIER("n") MINUS NUMBER(1) RIGHT_PAREN
RIGHT_BRACE

IDENTIFIER("print") LEFT_PAREN IDENTIFIER("factorial") LEFT_PAREN NUMBER(5) RIGHT_PAREN RIGHT_PAREN

FN IDENTIFIER("greet") LEFT_PAREN IDENTIFIER("name") COMMA IDENTIFIER("times") RIGHT_PAREN LEFT_BRACE
LET IDENTIFIER("i") EQUAL NUMBER(0)
WHILE LEFT_PAREN IDENTIFIER("i") LESS IDENTIFIER("times") RIGHT_PAREN LEFT_BRACE
IDENTIFIER("print") LEFT_PAREN STRING("Hello ") PLUS IDENTIFIER("name") RIGHT_PAREN
IDENTIFIER("i") EQUAL IDENTIFIER("i") PLUS NUMBER(1)
RIGHT_BRACE
RIGHT_BRACE

